# Explicitly (re)grant access to this directory in case a parent directory's
# .htaccess (if any exists on your host's account root) denies by default -
# without this, some hosts' AllowOverride scope can cascade a parent "deny" down
# into this docroot even though nothing here should ever be blocked.
Require all granted

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|md)$">
    Require all denied
</FilesMatch>

# display_errors is already disabled at runtime in src/bootstrap.php; not set here
# via php_flag because that directive errors out under php-fpm/suPHP handlers.
