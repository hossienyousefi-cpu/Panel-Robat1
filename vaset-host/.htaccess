# خاموش کردن نمایش لیست فایل‌های پوشه
Options -Indexes

# جلوگیری از دانلود مستقیم فایل‌های حساس (install.sql شامل هش پسورد ادمین
# پیش‌فرضه، migrations/*.sql هم همینطور؛ .git و .env هم نباید هیچ‌وقت وب‌قابل‌دیدن باشن)
<FilesMatch "\.(sql|sqlite|log|env|md|bak|ini|conf|git)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git/ - [F,L]
</IfModule>

# هدرهای امنیتی پایه برای همه‌ی صفحات
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
