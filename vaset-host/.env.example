# --- دیتابیس اختصاصی سیستم (روی Host vaset) ---
DB_HOST=127.0.0.1
DB_NAME=panel_vaset
DB_USER=panel_vaset
DB_PASS=CHANGE_ME

# --- فقط برای اولین راه‌اندازی (public/install.php) در هاست‌های cPanel بدون Terminal ---
# یک مقدار تصادفی طولانی بگذارید، صفحه را یک‌بار با ?token=همین‌مقدار باز کنید، بعد
# public/install.php را از File Manager حذف کنید. اگر install.php را حذف کردید دیگر
# لازم نیست این مقدار را نگه دارید.
INSTALL_TOKEN=CHANGE_ME_RANDOM_STRING

# --- اتصال مستقیم به پنل مدیریت IBSng (پیش‌فرض؛ هیچ‌چیز روی سرور IBSng نصب نمی‌شود) ---
# این مقادیر فقط "پیش‌فرض اولیه" هستند؛ بعد از اولین اجرا، از پنل ادمین
# (/admin/settings.php) یا از داخل ربات تلگرام (بخش مدیریتی) قابل تغییرند و آن مقدار
# در دیتابیس (system_settings) بر این مقدار اولویت می‌گیرد.
IBSNG_CONNECTION_MODE=direct
IBSNG_ADMIN_BASE_URL=https://194.59.214.84/IBSng/admin
IBSNG_ADMIN_USERNAME=CHANGE_ME
IBSNG_ADMIN_PASSWORD=CHANGE_ME
IBSNG_ADMIN_VERIFY_SSL=false

# --- اتصال به IBSng Agent از طریق تونل SSH (روش قدیمی/پشتیبان - نگاه کنید به docs/DEPLOYMENT.md) ---
# فقط وقتی لازم است که IBSNG_CONNECTION_MODE=agent باشد.
IBSNG_AGENT_URL=http://127.0.0.1:9091
IBSNG_AGENT_API_KEY=CHANGE_ME_LONG_RANDOM_STRING

# --- ابزارهای Export/Import دیتابیس از طریق ربات تلگرام (تسک ۴) ---
MYSQLDUMP_PATH=mysqldump
MYSQL_CLI_PATH=mysql

# --- ربات تلگرام مشتریان مستقیم (تسک ۱) ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_RANDOM_STRING
SUPPORT_CONTACT_MESSAGE="برای پشتیبانی به آیدی @your_support_id در تلگرام پیام دهید."
PAYMENT_CARD_INFO="شماره کارت: 6037-XXXX-XXXX-XXXX به نام ..."

# ISP که یوزرهای فروش مستقیم ربات تلگرام (بدون Reseller) به آن بایند می‌شوند
IBSNG_DIRECT_ISP=default

# پیش‌فرض‌های ساخت/تمدید یوزر در IBSng
IBSNG_DEFAULT_CREDIT1=100
IBSNG_DEFAULT_CREDIT2=0
IBSNG_RENEW_CREDIT1=100
