[Unit]
Description=IBSng Agent (bridge API for Host vaset, loopback only)
After=network.target mysql.service mariadb.service

[Service]
Type=simple
WorkingDirectory=/opt/ibsng-agent
ExecStart=/usr/bin/php -S 127.0.0.1:9090 -t public public/index.php
Restart=on-failure
RestartSec=3
User=www-data
Group=www-data

# The built-in PHP dev server is single-threaded; fine for a low-frequency internal
# admin bridge. If you need concurrency, swap this for php-fpm + a local nginx/apache
# vhost listening on 127.0.0.1:9090 pointing at public/index.php instead - nothing in
# the app code needs to change.

[Install]
WantedBy=multi-user.target
