# Dependencies
/vaset-host/vendor/
/ibsng-agent/vendor/

# Local secrets - never commit real credentials
/vaset-host/.env
/ibsng-agent/config.php

# Runtime data
/vaset-host/storage/logs/*.log
/vaset-host/storage/backups/*
!/vaset-host/storage/backups/.gitkeep
/vaset-host/storage/imports/*
!/vaset-host/storage/imports/.gitkeep
/vaset-host/storage/sessions/*
!/vaset-host/storage/sessions/.gitkeep
/vaset-host/storage/ibsng/*
!/vaset-host/storage/ibsng/.gitkeep
/vaset-host/public/uploads/receipts/*
!/vaset-host/public/uploads/receipts/.gitkeep

# OS / editor
.DS_Store
*.swp
